// กฎความปลอดภัยของ Firestore สำหรับเฟส 2 (ยังไม่ได้ใช้งานตอนนี้)
//
// หลักการ: จำกัดสิทธิ์ที่ฝั่งเซิร์ฟเวอร์เท่านั้น การเช็คใน JS ฝั่งเว็บไม่นับเป็นความปลอดภัย
// เพราะใครก็แก้โค้ดฝั่งเว็บหรือยิง API ตรง ๆ ได้
//
// ก่อนใช้จริง:
//   1) แทน OWNER_EMAIL_HERE ด้วยอีเมลจริงของเจ้าของ
//   2) จำกัด Firebase Web API key ใน Google Cloud Console
//      (HTTP referrer ผูกกับโดเมนที่โฮสต์จริง และเปิดเฉพาะ API ที่ใช้)
//   3) ใส่เฉพาะโดเมนที่โฮสต์จริงใน Authorized domains ของ Firebase Auth
//   4) ห้ามใช้กฎแบบ test mode (allow read, write: if true) แม้ชั่วคราว

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'OWNER_EMAIL_HERE'
        && request.auth.token.email_verified == true;
    }

    function validTx(d) {
      return d.keys().hasOnly(['id','kind','name','amount','type','group','date','createdAt','updatedAt','deleted','slipRef','slipHash','syncedAt'])
        && d.keys().hasAll(['id','kind','name','group','date','createdAt','updatedAt','deleted'])
        && d.id is string && d.id.size() <= 64
        && d.kind in ['income','expense']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && (!('amount' in d) || d.amount == null || (d.amount is number && d.amount >= 0 && d.amount < 100000000))
        && (!('type' in d) || d.type == null || (d.type is string && d.type.size() <= 100))
        && d.group in ['IN','DE','SD','IV','SV']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt is int && d.updatedAt is int
        && d.deleted is bool
        // รายการจากสลิป: รหัสธนาคาร 3 หลัก + เลขอ้างอิงจาก QR และลายนิ้วมือ SHA-256 ของไฟล์รูป
        && (!('slipRef' in d) || d.slipRef == null
            || (d.slipRef is string && d.slipRef.matches('^[0-9]{3}:[A-Za-z0-9]{6,40}$')))
        && (!('slipHash' in d) || d.slipHash == null
            || (d.slipHash is string && d.slipHash.matches('^[0-9a-f]{64}$')))
        // เวลาที่ถึงเซิร์ฟเวอร์ (serverTimestamp) — ใช้ดึงเฉพาะที่เปลี่ยนตั้งแต่ซิงก์ครั้งก่อน ปลอมเวลาไม่ได้
        && (!('syncedAt' in d) || d.syncedAt == request.time);
    }

    function validCategory(c) {
      return c.keys().hasOnly(['name','group','aliases','archived'])
        && c.keys().hasAll(['name','group','archived'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 100
        && c.group in ['IN','DE','SD','IV','SV']
        && c.archived is bool
        && (!('aliases' in c) || (c.aliases is list && c.aliases.size() <= 50));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['categories','budgets','openingBalances','carryOverBalance','lastBackupAt','updatedAt'])
        && d.categories is list && d.categories.size() <= 2000
        // Firestore rules วนลูปทั้ง list ไม่ได้ จึงสุ่มตรวจโครงสร้างเท่าที่ทำได้
        && (d.categories.size() == 0 || validCategory(d.categories[0]))
        && d.budgets is map
        && d.budgets.keys().hasOnly(['defaults','months'])
        && (!('defaults' in d.budgets) || d.budgets.defaults is map)
        && (!('months' in d.budgets) || d.budgets.months is map)
        && d.openingBalances is map
        && (!('carryOverBalance' in d) || d.carryOverBalance is bool)
        && (!('lastBackupAt' in d) || d.lastBackupAt == null || d.lastBackupAt is string)
        && (!('updatedAt' in d) || d.updatedAt is int);
    }

    match /users/{uid}/transactions/{txId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validTx(request.resource.data)
        && request.resource.data.id == txId;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/meta/settings {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings(request.resource.data);
      allow delete: if false;
    }

    // ------------------------------------------------------------ หารกัน
    // เอกสาร pairs/{pairId} สร้างเองใน Firebase console เท่านั้น (แอปเขียนไม่ได้):
    //   members: [อีเมลเธอ, อีเมลเขา]   ตัวพิมพ์เล็กทั้งหมด
    //   names:   [ชื่อเธอ, ชื่อเขา]      ลำดับเดียวกับ members
    //   owner:   อีเมลของเจ้าของแอป (คนที่ใช้บันทึกรายรับรายจ่ายส่วนตัว)
    // สองคนนี้เห็นเฉพาะรายการหารกัน — ข้อมูลส่วนตัว (users/...) ยังเป็นของ owner คนเดียวตามกฎด้านบน

    function pairMembers(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    function isMember(pairId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in pairMembers(pairId);
    }

    function validSplit(d, pairId) {
      let members = pairMembers(pairId);
      return d.keys().hasOnly(['id','kind','debtor','creditor','amount','total','name','date',
                               'settled','settledBy','settledAt','settledAs','createdBy','createdAt',
                               'updatedAt','updatedBy','deleted','bucket'])
        && d.keys().hasAll(['id','kind','debtor','creditor','amount','name','date','settled',
                            'createdBy','createdAt','updatedAt','updatedBy','deleted'])
        && d.id is string && d.id.matches('^[A-Za-z0-9_-]{1,64}$')
        && d.kind in ['item','payment']
        && d.debtor in members && d.creditor in members && d.debtor != d.creditor
        && d.amount is number && d.amount > 0 && d.amount < 100000000
        && (!('total' in d) || d.total == null
            || (d.total is number && d.total >= d.amount && d.total < 100000000))
        && d.name is string && d.name.size() <= 200 && (d.kind == 'payment' || d.name.size() > 0)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.settled is bool
        && (!('settledBy' in d) || d.settledBy == null || d.settledBy in members)
        && (!('settledAt' in d) || d.settledAt == null || d.settledAt is int)
        // เคลียร์แบบไหน: โอนกันแล้ว หรือ ไม่ต้องคืน
        && (!('settledAs' in d) || d.settledAs == null || d.settledAs in ['paid','forgiven'])
        // กลุ่ม: ทั่วไป หรือ ค่าบ้าน (แยกยอดและการโอนคืนกัน)
        && (!('bucket' in d) || d.bucket == null || d.bucket in ['general','home'])
        && d.createdBy in members
        && d.createdAt is int && d.updatedAt is int
        // คนที่แก้ต้องเป็นคนที่เข้าสู่ระบบอยู่จริง ปลอมชื่ออีกฝ่ายไม่ได้
        && d.updatedBy == request.auth.token.email
        && d.deleted is bool;
    }

    match /pairs/{pairId} {
      allow read: if isMember(pairId);
      allow write: if false;
    }

    match /pairs/{pairId}/splits/{splitId} {
      allow read: if isMember(pairId);
      allow create: if isMember(pairId)
        && validSplit(request.resource.data, pairId)
        && request.resource.data.id == splitId
        && request.resource.data.createdBy == request.auth.token.email;
      // แก้ได้ทั้งสองคน (ติ๊กเคลียร์ แก้ยอด ลบแบบ soft) แต่ห้ามเปลี่ยนว่าใครสร้าง/ชนิด/เวลาสร้าง
      allow update: if isMember(pairId)
        && validSplit(request.resource.data, pairId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      // ลบจริงไม่ได้ ใช้ deleted: true แทน เพื่อให้อีกเครื่องรู้ว่าถูกลบ (และเลิกทำได้)
      allow delete: if false;
    }

    // ชื่อเล่น: เอกสาร id = อีเมลของคนตั้ง เก็บชื่อที่คนนั้นใช้เรียกอีกฝ่าย
    // อ่านได้ทั้งสองคน (อีกฝ่ายจะเห็นว่าถูกเรียกว่าอะไร) แต่แก้ได้เฉพาะเอกสารของตัวเอง
    match /pairs/{pairId}/nicknames/{setter} {
      allow read: if isMember(pairId);
      allow create, update: if isMember(pairId)
        && request.auth.token.email == setter
        && request.resource.data.keys().hasOnly(['name','updatedAt'])
        && request.resource.data.keys().hasAll(['name','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.updatedAt is int;
      allow delete: if isMember(pairId) && request.auth.token.email == setter;
    }

    // ทางลัดหารกัน: ใช้ร่วมกันสองคน แก้/ลบได้ทั้งคู่
    match /pairs/{pairId}/shortcuts/{shortcutId} {
      allow read: if isMember(pairId);
      allow create, update: if isMember(pairId)
        && request.resource.data.keys().hasOnly(['id','name','payer','mode','amount','bucket','order','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['id','name','payer','mode','bucket','order','updatedAt','updatedBy'])
        && request.resource.data.id == shortcutId
        && shortcutId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.payer in pairMembers(pairId)
        && request.resource.data.mode in ['full','half']
        && (!('amount' in request.resource.data) || request.resource.data.amount == null
            || (request.resource.data.amount is number && request.resource.data.amount > 0
                && request.resource.data.amount < 100000000))
        && request.resource.data.bucket in ['general','home']
        && request.resource.data.order is int && request.resource.data.order >= 0 && request.resource.data.order < 1000
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isMember(pairId);
    }

    // ทุกอย่างที่เหลือปิดหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
